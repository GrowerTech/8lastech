# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# Required in production: random 32+ chars (e.g. `openssl rand -base64 48`).
# Used for CSRF/HMAC derivations. Rotating it does not invalidate sessions (those are DB-backed).
SESSION_SECRET=""

# Vercel Blob read/write token (media uploads). Create a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# Comma-separated origins allowed to call the admin API from a browser, in addition to same-origin.
# Leave empty to allow same-origin only.
ADMIN_ALLOWED_ORIGINS=""

# Public site origin, e.g. https://atlastech.com (used for origin checks and canonical URLs)
SITE_URL="http://localhost:3000"

# Used only by `npm run db:seed` to create the first SUPER_ADMIN.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
